# ==========================================
# Sahayi Environment Configuration Example
# Copy to .env and fill in your values
# ==========================================

# 1. Meta WhatsApp Cloud API
META_PHONE_NUMBER_ID=1337396096134122
META_ACCESS_TOKEN=your_meta_access_token_here
META_VERIFY_TOKEN=sahayi_token_2026

# 2. Designated Phone Numbers (E.164 format with country code)
ELDER_PHONE_NUMBER=+917012649561
CAREGIVER_WHATSAPP_NUMBER=+917736246747

# 3. Audio & Voice Storage
SAHAYI_AUDIO_DIR=data/saved_audio

# 4. Optional AI / LLM Keys (for Voice STT and Conversational Agent)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# 5. Optional Twilio Fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

